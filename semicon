Cleaning the data
Phase 1: Remove useless features (zero/near zero variation)

import numpy as np

#calculate variance for numeric features

variances = df[feature_cols].var()

#identify zero variance feature

zero_var_cols = variances[variances == 0].index.tolist()

len(zero_var_cols)

#drop these columns
df = df.drop(columns = zero_var_cols)

Phase 2: Handle missing values

#% missing per column
missing_pct = df.isna().mean() * 100

missing_pct.sort_values(ascending = False).head(10)


#drop columns with > 30% missing values
#Impute remaining missing values with median

cols_to_exclude = [id_col, target_col]

high_missing_cols = (missing_pct.drop(labels = cols_to_exclude, errors = 'ignore'))[missing_pct > 30].index

df = df.drop(columns = high_missing_cols, errors = 'ignore')

#median imputation
df = df.fillna(df.median(numeric_only = True))

#this avoids aggressive data loss

Phase 3 Sanity Check

